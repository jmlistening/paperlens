# Copy to .env and fill in your own values. Never commit .env.
# DeepSeek / OpenAI-compatible endpoint
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=your_model_id

# Email (163 example: smtp.163.com, 465, ssl, app authorization code)
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=your_account@163.com
SMTP_PASSWORD=your_app_authorization_code
MAIL_TO=your_account@163.com

# Optional
# SMTP_FROM_NAME=PaperLens
# UNSUBSCRIBE_MAILTO=
# Set to 0 to disable page-blind Chinese query rewriting in QA.
# PAPERLENS_QUERY_REWRITE=1
